# Submission Review SPA build settings (Vite). Copy to frontend/.env (or .env.production) if you need to change them;
# with no file at all the defaults below apply. Values are baked into the bundle at build time and are visible to
# every browser, so never put a secret here. Parsed and validated in src/config/env.ts.

# Where the API lives: a path on the same origin (default /api, served by nginx and by the Vite dev proxy) or an
# absolute URL. An absolute URL needs that origin allowed by the backend's FRONTEND_ORIGIN (CORS) and cookie setup.
VITE_API_BASE=/api

# How new-email notifications arrive: sse (a held stream; default) or poll (every 15 s; for hosts without long-lived
# streams, such as Netlify Functions: docs/deploy-netlify.md).
VITE_EVENTS_TRANSPORT=sse

# How files are uploaded: direct (one multipart request; default) or chunked (3 MiB parts, for hosts that cap a
# request body at a few MB, such as Netlify Functions). Rate workbooks are always sent directly (they are small).
VITE_UPLOAD_MODE=direct

# Dev server only: port of the API the Vite proxy forwards /api to. Defaults to PORT from backend/.env, then 3002.
# Set it as an environment variable, not in this file (vite.config.ts reads process.env).
# BACKEND_PORT=3002
