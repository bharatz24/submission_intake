# Docker Compose variables for Submission Review. Never commit a filled-in copy.
#
# This file covers only the values Compose substitutes into docker-compose.yml / docker-compose.prod.yml.
# The API's own settings (secrets, Google, Claude, limits...) are in backend/env.example -> backend/.env,
# and the SPA's build settings are in frontend/env.example.
#
#   Development:  cp env.example .env           (Compose reads ./.env automatically)
#                 docker compose up -d
#   Production:   cp env.example deploy.env     (on the host, chmod 600)
#                 docker compose -f docker-compose.prod.yml --env-file deploy.env up -d
#
# Keep these out of backend/.env: that file is loaded into the API container, and the database passwords below
# must not be visible to it. See docs/deploy.md.

# ---- Development (docker-compose.yml) -----------------------------------------------------------------------------
# Port on 127.0.0.1 where the dev Postgres listens. The backend's built-in dev DATABASE_URL and the tests expect 5435.
DB_PORT=5435
# Dev database superuser password. The default below matches the backend's built-in dev DATABASE_URL; change both
# together if you change it.
POSTGRES_PASSWORD=ims_dev_password

# ---- Production (docker-compose.prod.yml) -------------------------------------------------------------------------
# Images CI built, tested and pushed to GHCR (the `images` job in .github/workflows/ci.yml). Nothing is built on the
# host. Lowercase repository path, without the -backend / -frontend suffix.
IMAGE_PREFIX=ghcr.io/<owner>/<repo>
# Commit SHA to run (the full 40-character SHA CI tagged the images with). Roll back by setting the previous SHA and
# running `up -d` again.
RELEASE_SHA=

# Bootstrap superuser of the Postgres container. Used only by the release jobs (backup, db-roles, db-grants), never by
# the API. Production: replace the dev default above with a long random value.
# Least-privilege roles created by backend/scripts/db-roles.sql:
#   ims_migrator owns the schema and runs migrations; ims_app (the API) can only read and write rows.
# They are embedded in connection URLs, so use URL-safe values: openssl rand -hex 24
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=

# Number of proxies that append X-Forwarded-For in front of the API. 2 = TLS edge (load balancer / Caddy / Traefik)
# + nginx in the web container. Use 1 only if nginx is reached directly with no edge proxy. Never "true".
# TRUST_PROXY=2
