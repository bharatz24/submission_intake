{
  "name": "submission-review",
  "private": true,
  "description": "Repo-level tooling only (git hooks, formatting). The apps live in backend/ and frontend/.",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "e2e": "npm --prefix e2e test",
    "compose:prod:config": "docker compose -f docker-compose.prod.yml --env-file deploy.env config --quiet"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.6.2"
  }
}
