{
  // Typecheck only (Netlify bundles the functions with esbuild): node ../backend/node_modules/typescript/bin/tsc -p .
  // The backend is imported from backend/dist (build it first); allowJs infers its types from the compiled JS.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["../backend/node_modules/@types"]
  },
  "include": ["functions/*.mts"]
}
