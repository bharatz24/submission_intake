{
  "name": "submission-intake-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "rates:import": "tsx scripts/import-rates.ts rates",
    "geo:import": "tsx scripts/import-rates.ts geo",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js .",
    "eval": "tsx src/evals/run.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@netlify/blobs": "11.1.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^188.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "15.1.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "^17.14.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "uuid": "^14.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
