# Submission Review backend configuration.
# Copy to backend/.env and fill in the REQUIRED values. Every key the server reads is listed here (src/config.ts
# EnvSchema); tests/envExample.test.ts fails when the two drift apart. Commented-out keys are optional: the value
# shown is the default, or an example. Never commit a real .env.

# ---- Server -------------------------------------------------------------------------------------------------------
NODE_ENV=development                      # development | test | production
PORT=3002
FRONTEND_ORIGIN=http://localhost:5174     # browser origin allowed by CORS (with credentials); https in production
LOG_LEVEL=info                            # fatal | error | warn | info | debug | trace | silent
# Reverse proxies in front of the API: false, a hop count (e.g. 1), or addresses/subnets. "true" is refused.
TRUST_PROXY=false
API_RATE_LIMIT_PER_MIN=300                # requests per minute per client IP across /api
LOGIN_RATE_LIMIT_PER_15MIN=20             # login/register attempts per 15 minutes per IP
LOGIN_ACCOUNT_RATE_LIMIT_PER_15MIN=10     # failed sign-ins per 15 minutes per account from one IP
LOGIN_ACCOUNT_TOTAL_RATE_LIMIT_PER_15MIN=100  # failed sign-ins per 15 minutes per account from all IPs
# RATE_LIMIT_STORE=postgres               # postgres (shared by all instances) | memory (per process); default postgres
SHUTDOWN_TIMEOUT_MS=25000                 # SIGTERM waits this long for running jobs
SSE_MAX_PER_USER=5                        # open notification streams per user
SSE_MAX_TOTAL=500                         # open notification streams per instance, all users together
# Prometheus scrape token for GET /api/metrics (Authorization: Bearer ...); unset turns the endpoint off.
# METRICS_TOKEN=
# Webhook that receives system errors as JSON {"text": ...} (Slack-compatible), deduplicated. Keep it secret.
# ALERT_WEBHOOK_URL=
# How background work is triggered: server (long-running process) | netlify (Netlify Functions; docs/deploy-netlify.md)
RUNTIME=server
# Shared secret for triggering the Netlify worker function (32+ characters); required when RUNTIME=netlify.
# WORKER_TOKEN=

# ---- Secrets (REQUIRED) -------------------------------------------------------------------------------------------
# Left blank on purpose: the server refuses to start until they are set. In production, values copied from docs,
# repetitive values, and JWT_SECRET equal to ENCRYPTION_KEY are refused too.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Encrypts the Gmail refresh token and the Anthropic key at rest: base64:<32 random bytes> from
# `openssl rand -base64 32` (required in production), or a 32+ character passphrase (development only).
# To rotate, see docs/deploy.md.
ENCRYPTION_KEY=
# ENCRYPTION_KEYS_PREVIOUS=                # old ENCRYPTION_KEY values (comma-separated), only while rotating
JWT_EXPIRES_IN=8h
# One-time secret for creating the first (administrator) account, entered on the setup screen. Required for that in
# production (16+ characters); unused once a user exists.
# SETUP_TOKEN=

# ---- Database -----------------------------------------------------------------------------------------------------
# Unset outside production: the docker-compose database (postgres://ims:ims_dev_password@localhost:5435/ims).
# REQUIRED in production.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# MIGRATION_CHECKSUM_CHECK=fail          # an applied migration file was edited: warn (log) or fail (refuse to start); default fail in production, warn otherwise
# MIGRATION_REPLAY_CHECK=warn            # migrations could not be replayed to verify the schema: warn or fail; default fail when CI is set
# MIGRATION_LOCK_TIMEOUT_MS=15000        # a migration waiting longer for a table lock fails and rolls back; 0 waits forever
# DB_POOL_MAX=16                          # default JOB_CONCURRENCY x 2 + 10 (3 when RUNTIME=netlify)
# DB_LOCK_POOL_MAX=7                      # default JOB_CONCURRENCY + 4 (long-held advisory locks; 2 when RUNTIME=netlify)
DB_STATEMENT_TIMEOUT_MS=30000             # 0 disables
DB_IDLE_IN_TX_TIMEOUT_MS=60000            # 0 disables
DB_CONNECTION_TIMEOUT_MS=10000            # wait for a free pool connection, then 503; 0 waits forever
DB_LOCK_TIMEOUT_MS=10000                  # wait for a lock, then fail (503); 0 disables

# ---- Google (REQUIRED: attachments are stored in Google Drive) ----------------------------------------------------
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Refresh token for GOOGLE_CLIENT_ID with the https://www.googleapis.com/auth/drive scope (Drive storage).
GOOGLE_REFRESH_TOKEN=your-drive-refresh-token
GOOGLE_REDIRECT_URI=http://localhost:3002/api/gmail/oauth/callback  # https on the public host in production
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# ---- Google Drive storage -----------------------------------------------------------------------------------------
GDRIVE_ROOT_FOLDER_NAME=Submission Review # environments sharing a Google account need different names
# GDRIVE_SHARED_DRIVE_ID=                 # store under a shared drive instead of My Drive
GDRIVE_UPLOAD_CONCURRENCY=3
GDRIVE_CACHE_MB=200                       # in-memory file cache; 0 disables
GDRIVE_CACHE_TTL_MINUTES=30
GDRIVE_ORPHAN_SWEEP_MAX=100               # a sweep finding more orphans than this trashes nothing
ATTACHMENT_MAX_BYTES=104857600

# ---- Gmail ---------------------------------------------------------------------------------------------------------
# Production push notifications (see README "Gmail setup").
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# GMAIL_PUSH_TOKEN=long-random-value
GMAIL_RETRY_ALERT_AFTER=5
INGEST_MAX_ATTEMPTS=20                    # failed attempts before a Gmail message is parked on the Errors tab
RECONCILE_DAYS=7
# Read mail through a Gmail MCP server instead of OAuth (also used when GOOGLE_CLIENT_ID/SECRET are unset).
GMAIL_ENABLE_VIA_MCP=false
# GMAIL_MCP_URL=http://localhost:8080/mcp
# GMAIL_MCP_TOKEN=
# GMAIL_MCP_COMMAND=npx
GMAIL_MCP_ARGS=
GMAIL_MCP_SEARCH_TOOL=search_emails
GMAIL_MCP_READ_TOOL=read_email
GMAIL_MCP_SEND_TOOL=send_email

# ---- Outbound mail -------------------------------------------------------------------------------------------------
OUTBOUND_ALLOWED_DOMAINS=                 # comma-separated recipient domains; empty = any (warned in production)
OUTBOUND_SEND_LIMIT_PER_HOUR=30           # per user; 0 = unlimited

# ---- Claude (the API key and default model are set in Settings -> Claude API) ------------------------------------
# Optional per-task model overrides (claude-...).
# ANTHROPIC_MODEL_CLASSIFICATION=
# ANTHROPIC_MODEL_EXTRACTION=
# ANTHROPIC_MODEL_SYNTHESIS=
# ANTHROPIC_MODEL_ANALYSIS=
# ANTHROPIC_MODEL_CHAT=
# ANTHROPIC_MODEL_COMPARISON=
# ANTHROPIC_MODEL_QUOTE=
# ANTHROPIC_MODEL_EMAIL_DRAFT=
# Optional per-task prompt-cache lifetime: 5m | 1h.
# LLM_CACHE_TTL_CLASSIFICATION=
# LLM_CACHE_TTL_EXTRACTION=
# LLM_CACHE_TTL_SYNTHESIS=
# LLM_CACHE_TTL_ANALYSIS=
# LLM_CACHE_TTL_CHAT=
# LLM_CACHE_TTL_COMPARISON=
# LLM_CACHE_TTL_QUOTE=
# LLM_CACHE_TTL_EMAIL_DRAFT=
LLM_DAILY_TOKEN_BUDGET=20000000           # rolling 24 h, all calls; 0 = unlimited
LLM_SUBMISSION_DAILY_TOKEN_BUDGET=3000000 # rolling 24 h, one submission; never refuses classification/extraction; 0 = off
LLM_USER_HOURLY_LIMIT=60                  # AI requests per user per hour; 0 = unlimited
# Redacts SSNs, dates of birth and account numbers before text goes to Claude. false also means stored
# transcripts (LLM_STORE_TRANSCRIPTS) keep the prompts unredacted.
LLM_REDACT_PII=true
LLM_PROMPT_MAX_CHARS=400000
LLM_STORE_TRANSCRIPTS=decisions          # off | decisions | all: full prompt/output kept per call (hashes always)
AUTO_REPORTS=true                         # Synthesis -> Analysis -> quote after processing

# ---- Pipeline ------------------------------------------------------------------------------------------------------
DUPLICATE_DETECTION=true
DUPLICATE_LOOKBACK_DAYS=90
DUPLICATE_BODY_SIMILARITY=0.85
NPI_API_BASE=https://npiregistry.cms.hhs.gov/api/
EXTRACTION_TIMEOUT_MS=120000
OCR_TIMEOUT_MS=60000
OCR_MAX_PIXELS=40000000
# Folder with the OCR model eng.traineddata, relative to the working directory (shipped in assets/ocr).
OCR_DATA_PATH=assets/ocr
# Apply pending migrations at startup. Production: false, and run the release step (backup + migrate) before deploying.
MIGRATE_ON_BOOT=true
# Documents are parsed in worker threads, each with a heap limit and a hard per-file timeout (0 workers = main thread).
EXTRACTION_WORKERS=2
EXTRACTION_WORKER_MAX_MB=512
EXTRACTION_WORKER_TIMEOUT_MS=600000

# ---- Uploads -------------------------------------------------------------------------------------------------------
UPLOAD_MAX_TOTAL_MB=100
UPLOAD_CONCURRENCY=3

# ---- Background jobs -----------------------------------------------------------------------------------------------
JOB_CONCURRENCY=3
JOB_POLL_INTERVAL_MS=2000
JOB_LEASE_SECONDS=120
JOB_RETENTION_DAYS=7

# ---- Rating --------------------------------------------------------------------------------------------------------
RATES_DIR=data/rates
# RATE_GROUP=                             # name prefix for imported rate groups
DOMICILE_STATE=NC
GEO_AUTO_IMPORT=true

# ---- IMS 2 Submission Intake queue --------------------------------------------------------------------------------
# The queue URL and its token are set in Settings → IMS 2 intake (stored in the database, token encrypted), not here.
# IMS2_APP_URL=http://localhost:5704
IMS2_TIMEOUT_MS=20000
